"""
.env.example - Environment variables template
Copy to .env and fill in your values
"""

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///sandvision.db
# For PostgreSQL: postgresql://user:password@localhost/sandvision

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost

# File Upload
MAX_UPLOAD_SIZE=16777216
UPLOAD_FOLDER=uploads

# Image Processing
MIN_GRAIN_AREA=10
MAX_GRAIN_AREA=10000

# ML Model
MODEL_PATH=models/grain_classifier.pkl
CONFIDENCE_THRESHOLD=0.7

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/sandvision.log
